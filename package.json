{
  "name": "alphaxgym-challenge-platform",
  "version": "1.0.0",
  "description": "Alpha X Gym 100-Day Transformation Challenge Management Platform with PostgreSQL and Prisma ORM",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/build.js",
    "postinstall": "node scripts/build.js",
    "build:netlify": "prisma generate && tsc",
    "start": "node dist/src/server.js",
    "start:prod": "prisma migrate deploy && node dist/src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "gym",
    "fitness",
    "100-day-challenge",
    "prisma",
    "postgresql",
    "typescript"
  ],
  "author": "Alpha X Gym",
  "license": "ISC",
  "dependencies": {
    "@netlify/functions": "^6.0.0",
    "@prisma/client": "^6.4.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^6.4.1",
    "qrcode": "^1.5.4",
    "serverless-http": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {}
}
