# ============================================================
# ALPHA X GYM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development or set in your Cloud Provider (Render)
# ============================================================

# 1. DATABASE (PostgreSQL connection string with SSL in production)
# Example: postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/alphaxgym?schema=public"

# 2. SERVER PORT (Cloud hosts like Render set this automatically)
PORT=3000

# 3. ENVIRONMENT MODE ('development' or 'production')
NODE_ENV=production

# 4. AUTHENTICATION (64-character random string for signing JWT tokens)
JWT_SECRET="your_production_secure_random_jwt_secret_key_min_32_characters"

# 5. PUBLIC PRODUCTION DOMAIN (Used to generate QR code check-in & registration URLs)
# Set to your live deployed HTTPS URL, e.g. https://alphaxgym-platform.onrender.com or https://alphaxgym.com
APP_URL="https://your-deployed-domain.onrender.com"
BASE_URL="https://your-deployed-domain.onrender.com"

# 6. GOOGLE OAUTH 2.0 (From Google Cloud Console: https://console.cloud.google.com)
# Create a "Web Application" client ID and add your BASE_URL to Authorized JavaScript Origins
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_oauth_client_secret"

# 7. FACILITY GEOFENCE DEFAULTS (Can be customized in Admin Dashboard Settings)
GYM_DEFAULT_LAT="12.9716"
GYM_DEFAULT_LNG="77.5946"
GYM_ALLOWED_RADIUS="75.0"
